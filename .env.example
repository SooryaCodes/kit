# Meta Model API (OpenAI-compatible): https://dev.meta.ai/docs
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Baseten Model APIs: Muse Spark Open
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open

# fal: SAM 3D Objects (fal-ai/sam-3/3d-objects)
FAL_KEY=

# Supabase CLI (local only, for migrations)
SUPABASE_ACCESS_TOKEN=

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug

# Budget guard (lib/budget.ts). Every paid call is checked against these.
AI_DISABLED=false
MOCK_AI=false
MAX_SPEND_TOTAL_USD=100
MAX_SPEND_BASETEN_USD=20
MAX_SPEND_FAL_USD=8
MAX_SPEND_PER_JOB_USD=1
MAX_ITEMS_PER_JOB=16
MAX_JOBS_PER_DAY=40
MAX_JOBS_PER_IP_PER_HOUR=5
# Protects /api/admin/spend. 16+ random characters.
ADMIN_TOKEN=

# 3D mode: per-item fast calls until this much fal spend per day, then one combined call per photo
FAST_3D_DAILY_USD=3
